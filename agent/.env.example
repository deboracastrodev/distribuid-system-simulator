KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nexus-agent

# LangSmith (obrigatorio para LangGraph Studio)
LANGSMITH_API_KEY=your-key-here
LANGCHAIN_TRACING_V2=true

# Simulacao de falhas (defaults das flags da CLI; 0 = caminho feliz)
SIM_INVENTORY_FAILURE_RATE=0
SIM_PAYMENT_REJECTION_RATE=0
SIM_STEP_DELAY_MS=0
