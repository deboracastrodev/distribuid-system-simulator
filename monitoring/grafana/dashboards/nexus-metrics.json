        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nexus_event_settle_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true
